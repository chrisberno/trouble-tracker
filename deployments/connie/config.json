{
  "id": "connie",
  "displayName": "Connie",
  "ppTenant": {
    "url": "https://troubletracker.peopleperson.app",
    "apiTokenEnvVar": "TROUBLETRACKER_TENANT_API_TOKEN"
  },
  "statusMap": {
    "open": 1,
    "in_progress": 2,
    "waiting": 4,
    "closed": 5
  },
  "customFieldIds": {
    "ticket": {
      "customer_scope": 1,
      "intake_source": 2
    }
  },
  "twilio": {
    "accountSidEnvVar": "TWILIO_RTC_ACCOUNT_SID",
    "authTokenEnvVar": "TWILIO_RTC_AUTH_TOKEN",
    "workspaceSid": "WSfe43abb4378f0f1e2ebb98877c03bd1d",
    "supportWorkflowSid": "WW2c597b1d5a96635b6cb0b6d261c9ede8",
    "supportQueueSid": "WQ9d76ef58cf2f171d511c36e0e0b05851",
    "conversationsServiceSid": "IS91e4bcb2939d4672a007ef27d323ad41",
    "taskAttributeType": "support_ticket",
    "taskChannel": "chat",
    "iframeBaseUrl": "https://trouble-ticket-app.vercel.app/bridge/twilio-flex/ticket"
  },
  "customerScopes": [
    { "scope": "NSS",      "refererMatch": "nss.connie.team" },
    { "scope": "HHOVV",    "refererMatch": "hhovv.connie.team" },
    { "scope": "Lifeline", "refererMatch": "lifeline.connie.team" }
  ],
  "defaultPriority": "medium",
  "corsAllowlist": [
    "https://connie.team",
    "https://nss.connie.team",
    "https://hhovv.connie.team",
    "https://lifeline.connie.team"
  ],
  "fallbackEmail": "tickets@connie.peopleperson.app",
  "channels": {
    "customerEmail": {
      "enabled": true,
      "events": ["ticket.created", "ticket.replied.agent"],
      "replyTo": "replies@crm.connie.center",
      "replyToForward": "support@connie.team",
      "inboundWebhook": true
    },
    "flexCustomerReplyNotification": {
      "enabled": true
    }
  }
}
